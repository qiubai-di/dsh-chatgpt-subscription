{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "types": [
      "node"
    ],
    "outDir": ".test-build",
    "noUncheckedIndexedAccess": true,
    "noEmit": false,
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": ["src/client", "test/plan-client.test.tsx"]
}
